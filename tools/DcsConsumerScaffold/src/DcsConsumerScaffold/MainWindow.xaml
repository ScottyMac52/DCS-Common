<Window x:Class="DcsConsumerScaffold.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DCS Input Profile Importer"
        Height="720" Width="1100"
        MinHeight="480" MinWidth="800">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock FontSize="18" FontWeight="SemiBold" Text="DCS Input Profile Importer" />
      <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#555"
                 Text="Option A shell: loads DCS .diff.lua profiles via the Node scaffold engine (node on PATH). Proceed / write path comes in a later release." />
    </StackPanel>

    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Profiles directory" />
      <DockPanel Grid.Row="0" Grid.Column="1" Margin="8,2,0,2">
        <Button DockPanel.Dock="Right" Content="Browse…" Width="90" Margin="8,0,0,0" Click="BrowseProfiles_Click" />
        <TextBox Text="{Binding ProfilesDir, UpdateSourceTrigger=PropertyChanged}" />
      </DockPanel>

      <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="modifiers.lua (optional)" />
      <DockPanel Grid.Row="1" Grid.Column="1" Margin="8,2,0,2">
        <Button DockPanel.Dock="Right" Content="Browse…" Width="90" Margin="8,0,0,0" Click="BrowseModifiers_Click" />
        <TextBox Text="{Binding ModifiersPath, UpdateSourceTrigger=PropertyChanged}" />
      </DockPanel>

      <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="DCS-Common root (optional)" />
      <DockPanel Grid.Row="2" Grid.Column="1" Margin="8,2,0,2">
        <Button DockPanel.Dock="Right" Content="Browse…" Width="90" Margin="8,0,0,0" Click="BrowseCommon_Click" />
        <TextBox Text="{Binding CommonRoot, UpdateSourceTrigger=PropertyChanged}" />
      </DockPanel>

      <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
        <Button Content="Load Preview" Padding="16,6" Command="{Binding LoadPreviewCommand}" />
        <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="{Binding SummaryText}" FontWeight="SemiBold" />
      </StackPanel>
    </Grid>

    <TextBox DockPanel.Dock="Bottom" Height="90" Margin="0,8,0,0"
             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
             Text="{Binding StatusText}" />

    <DataGrid ItemsSource="{Binding Rows}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              HeadersVisibility="Column"
              AlternatingRowBackground="#F5F7FA">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Device / stem" Binding="{Binding Stem}" Width="1.4*" />
        <DataGridTextColumn Header="deviceId" Binding="{Binding DeviceId}" Width="*" />
        <DataGridTextColumn Header="Inst" Binding="{Binding InstanceHint}" Width="50" />
        <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="90" />
        <DataGridTextColumn Header="Chord" Binding="{Binding Chord}" Width="100" />
        <DataGridTextColumn Header="Modes" Binding="{Binding ModifierModesDisplay}" Width="80" />
        <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="*" />
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.2*" />
        <DataGridTextColumn Header="Callout" Binding="{Binding CalloutId}" Width="110" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
