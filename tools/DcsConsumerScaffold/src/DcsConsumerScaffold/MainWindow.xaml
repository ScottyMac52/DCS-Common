<Window x:Class="DcsConsumerScaffold.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DcsConsumerScaffold.Models"
        Title="DCS Input Profile Importer"
        Height="900" Width="1200"
        MinHeight="520" MinWidth="800">
  <Window.Resources>
    <Style x:Key="PreviewChangeRowStyle" TargetType="DataGridRow">
      <Setter Property="ToolTip" Value="{Binding ChangeReason}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ChangeState}" Value="{x:Static models:PreviewChangeState.New}">
          <Setter Property="Background" Value="#C6EFCE" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ChangeState}" Value="{x:Static models:PreviewChangeState.Changed}">
          <Setter Property="Background" Value="#FFEB9C" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ChangeState}" Value="{x:Static models:PreviewChangeState.OutOfSync}">
          <Setter Property="Background" Value="#FFEB9C" />
          <Setter Property="Foreground" Value="#9C0006" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ChangeState}" Value="{x:Static models:PreviewChangeState.Unused}">
          <Setter Property="Background" Value="#FFC7CE" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock FontSize="18" FontWeight="SemiBold" Text="DCS Input Profile Importer" />
      <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#555"
                 Text="Load Preview, review the resolved devices and labels, then Proceed with the selected import target." />
      <DockPanel Margin="0,8,0,0">
        <TextBlock Width="160" VerticalAlignment="Center" Text="Import target" />
        <ComboBox Width="310" HorizontalAlignment="Left"
                  SelectedValue="{Binding ImportTarget, UpdateSourceTrigger=PropertyChanged}"
                  SelectedValuePath="Tag">
          <ComboBoxItem Content="Consumer module repository" Tag="consumer" />
          <ComboBoxItem Content="DCS-Common authoritative UI Layer" Tag="ui-layer" />
        </ComboBox>
        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#555" TextWrapping="Wrap"
                   Text="UI Layer mode writes only assets/shared/ui-layer under the selected DCS-Common root." />
      </DockPanel>
    </StackPanel>

    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Profiles directory" />
      <DockPanel Grid.Row="0" Grid.Column="1" Margin="8,2,0,2">
        <Button DockPanel.Dock="Right" Content="Browse…" Width="90" Margin="8,0,0,0" Click="BrowseProfiles_Click" />
        <TextBox Text="{Binding ProfilesDir, UpdateSourceTrigger=PropertyChanged}" />
      </DockPanel>

      <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="modifiers.lua (optional)" />
      <DockPanel Grid.Row="1" Grid.Column="1" Margin="8,2,0,2">
        <Button DockPanel.Dock="Right" Content="Browse…" Width="90" Margin="8,0,0,0" Click="BrowseModifiers_Click" />
        <TextBox Text="{Binding ModifiersPath, UpdateSourceTrigger=PropertyChanged}" />
      </DockPanel>

      <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="MOZA AB9 configuration" />
      <ComboBox Grid.Row="2" Grid.Column="1" Margin="8,2,0,2"
                SelectedValue="{Binding MozaGrip, UpdateSourceTrigger=PropertyChanged}"
                SelectedValuePath="Tag"
                ToolTip="Applied only when a generic MOZA AB9 profile is present.">
        <ComboBoxItem Content="Standalone / no grip selection" Tag="standalone" />
        <ComboBoxItem Content="F-16C Viper Grip" Tag="viper" />
        <ComboBoxItem Content="F/A-18C/E/F Grip" Tag="hornet" />
      </ComboBox>

      <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="DCS-Common root (optional)" />
      <DockPanel Grid.Row="3" Grid.Column="1" Margin="8,2,0,2">
        <Button DockPanel.Dock="Right" Content="Browse…" Width="90" Margin="8,0,0,0" Click="BrowseCommon_Click" />
        <TextBox Text="{Binding CommonRoot, UpdateSourceTrigger=PropertyChanged}" />
      </DockPanel>

      <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Output directory" />
      <DockPanel Grid.Row="4" Grid.Column="1" Margin="8,2,0,2">
        <Button DockPanel.Dock="Right" Content="Browse…" Width="90" Margin="8,0,0,0" Click="BrowseOutput_Click" />
        <TextBox Text="{Binding OutputDir, UpdateSourceTrigger=PropertyChanged}" />
      </DockPanel>

      <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="Display name" />
      <TextBox Grid.Row="5" Grid.Column="1" Margin="8,2,0,2"
               Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

      <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="Input module ID" />
      <TextBox Grid.Row="6" Grid.Column="1" Margin="8,2,0,2"
               Text="{Binding InputModuleId, UpdateSourceTrigger=PropertyChanged}" />

      <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Text="Kneeboard ID" />
      <TextBox Grid.Row="7" Grid.Column="1" Margin="8,2,0,2"
               Text="{Binding KneeboardId, UpdateSourceTrigger=PropertyChanged}" />

      <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
        <Button Content="Load Preview" Padding="16,6" Command="{Binding LoadPreviewCommand}" />
        <Button Content="Proceed" Padding="16,6" Margin="8,0,0,0" Command="{Binding ProceedCommand}" />
        <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="{Binding SummaryText}" FontWeight="SemiBold" />
      </StackPanel>
    </Grid>

    <Border DockPanel.Dock="Top" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal">
        <TextBlock FontWeight="SemiBold" Margin="0,0,10,0" Text="Preview changes:" />
        <TextBlock Background="#C6EFCE" Padding="6,2" Margin="0,0,6,0" Text="New" />
        <TextBlock Background="#FFEB9C" Padding="6,2" Margin="0,0,6,0" Text="Changed" />
        <TextBlock Background="#FFEB9C" Foreground="#9C0006" Padding="6,2" Margin="0,0,6,0" Text="Out of sync" />
        <TextBlock Background="#FFC7CE" Padding="6,2" Margin="0,0,6,0" Text="Unused" />
        <TextBlock Padding="6,2" Text="White = unchanged / not compared" />
      </StackPanel>
    </Border>

    <GroupBox DockPanel.Dock="Top" Header="Physical device instances" Margin="0,0,0,8" Padding="4">
      <DataGrid ItemsSource="{Binding Devices}"
                Height="135"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                HeadersVisibility="Column"
                AlternatingRowBackground="#F5F7FA"
                RowStyle="{StaticResource PreviewChangeRowStyle}"
                BeginningEdit="PreviewGrid_BeginningEdit">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Profile" Binding="{Binding ProfileFile}" Width="2*" IsReadOnly="True" />
          <DataGridTextColumn Header="deviceId" Binding="{Binding DeviceId}" Width="*" IsReadOnly="True" />
          <DataGridTextColumn Header="GUID / physical instance" Binding="{Binding PhysicalInstance}" Width="1.5*" IsReadOnly="True" />
          <DataGridTextColumn Header="Role (optional)" Binding="{Binding Role, UpdateSourceTrigger=PropertyChanged}" Width="1.2*" />
          <DataGridTextColumn Header="Profile key" Binding="{Binding ProfileKey}" Width="1.5*" IsReadOnly="True" />
          <DataGridTextColumn Header="State" Binding="{Binding ChangeState}" Width="95" IsReadOnly="True" />
          <DataGridTemplateColumn Header="Remove" Width="70">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsChecked="{Binding RemoveRequested, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding IsRepositoryOnly}"
                          ToolTip="Explicitly remove this repository-only device; unchecked unused devices are preserved" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Labels" Width="150">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Current" Tag="{Binding}" Click="CurrentLabels_Click"
                          IsEnabled="{Binding CanPreview}" Margin="0,0,4,0"
                          ToolTip="Load this device's existing destination-repository labels; use shared hardware labels when undefined" />
                  <Button Content="Default" Tag="{Binding}" Click="DefaultLabels_Click"
                          IsEnabled="{Binding CanPreview}"
                          ToolTip="Restore this device's imported DCS label (default) values" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Kneeboard" Width="90">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="Preview" Tag="{Binding}" Click="PreviewDevice_Click"
                        IsEnabled="{Binding CanPreview}" ToolTip="{Binding PreviewReason}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </GroupBox>

    <GroupBox DockPanel.Dock="Top" Header="Modifier equivalence" Margin="0,0,0,8" Padding="4">
      <DataGrid ItemsSource="{Binding Modifiers}" Height="105" AutoGenerateColumns="False" CanUserAddRows="False"
                RowStyle="{StaticResource PreviewChangeRowStyle}" BeginningEdit="PreviewGrid_BeginningEdit">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Native modifier" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
          <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="2*" IsReadOnly="True" />
          <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="90" IsReadOnly="True" />
          <DataGridTextColumn Header="Semantic modifier" Binding="{Binding SemanticModifier, UpdateSourceTrigger=PropertyChanged}" Width="*" />
          <DataGridTextColumn Header="State" Binding="{Binding ChangeState}" Width="95" IsReadOnly="True" />
        </DataGrid.Columns>
      </DataGrid>
    </GroupBox>

    <GroupBox DockPanel.Dock="Top" Header="Command labels" Margin="0,0,0,8" Padding="4"
              ToolTip="One row per exact DCS command. Apply synchronizes every matching binding; individual labels remain editable below.">
      <DataGrid ItemsSource="{Binding CommandLabels}" Height="145" AutoGenerateColumns="False"
                CanUserAddRows="False" HeadersVisibility="Column" AlternatingRowBackground="#F5F7FA"
                RowStyle="{StaticResource PreviewChangeRowStyle}" BeginningEdit="PreviewGrid_BeginningEdit">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="2.4*" IsReadOnly="True" />
          <DataGridTextColumn Header="DCS label (default)" Binding="{Binding DefaultLabel}" Width="1.4*" IsReadOnly="True" />
          <DataGridTextColumn Header="Synchronized label"
                              Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="1.4*" />
          <DataGridTextColumn Header="Bindings" Binding="{Binding BindingCount}" Width="75" IsReadOnly="True" />
          <DataGridTextColumn Header="State" Binding="{Binding State}" Width="95" IsReadOnly="True" />
          <DataGridTextColumn Header="Change" Binding="{Binding ChangeState}" Width="95" IsReadOnly="True" />
          <DataGridTemplateColumn Header="" Width="90">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="Apply" Tag="{Binding}" Click="ApplyCommandLabel_Click" IsEnabled="{Binding CanEdit}"
                        ToolTip="Apply this label, including an intentional blank, to every binding with this exact command" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </GroupBox>

    <TextBox DockPanel.Dock="Bottom" Height="90" Margin="0,8,0,0"
             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
             Text="{Binding StatusText}" />

    <DataGrid ItemsSource="{Binding Rows}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              HeadersVisibility="Column"
              AlternatingRowBackground="#F5F7FA"
              RowStyle="{StaticResource PreviewChangeRowStyle}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Device / stem" Binding="{Binding Stem}" Width="1.2*" IsReadOnly="True" />
        <DataGridTextColumn Header="Physical profile" Binding="{Binding ProfileKey}" Width="1.8*" IsReadOnly="True" />
        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="1.1*" IsReadOnly="True" />
        <DataGridTextColumn Header="deviceId" Binding="{Binding DeviceId}" Width="*" IsReadOnly="True" />
        <DataGridTextColumn Header="Mapping" Binding="{Binding MappingSource}" Width="110" IsReadOnly="True" />
        <DataGridTextColumn Header="Inst" Binding="{Binding InstanceHint}" Width="50" IsReadOnly="True" />
        <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="90" IsReadOnly="True" />
        <DataGridTextColumn Header="Chord" Binding="{Binding Chord}" Width="100" IsReadOnly="True" />
        <DataGridTextColumn Header="Modes" Binding="{Binding ModifierModesDisplay}" Width="80" IsReadOnly="True" />
        <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="*" IsReadOnly="True" />
        <DataGridTextColumn Header="DCS label (default)" Binding="{Binding DefaultLabel}" Width="1.2*" IsReadOnly="True" />
        <DataGridTextColumn Header="Label" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="1.2*" />
        <DataGridTextColumn Header="Device label" Binding="{Binding DeviceLabel}" Width="1.2*" IsReadOnly="True" />
        <DataGridTemplateColumn Header="" Width="90">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate><Button Content="Use device" ToolTip="Replace Label with Device Label" Tag="{Binding}" Click="ResetLabel_Click" /></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Callout" Binding="{Binding CalloutId}" Width="110" IsReadOnly="True" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" IsReadOnly="True" />
        <DataGridTextColumn Header="Change" Binding="{Binding ChangeState}" Width="95" IsReadOnly="True" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
