<Window x:Class="DcsConsumerScaffold.UiLayerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Definitive UI Layer Editor" Height="820" Width="1350" MinHeight="600" MinWidth="900">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="Definitive UI Layer Editor" />
      <TextBlock Margin="0,3,0,8" Foreground="#555" TextWrapping="Wrap"
                 Text="Maintain every supported UI Layer device possibility independently of connected devices. Imported Saved Games data is only an observed snapshot; each module later projects its applicable subset." />
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="DCS-Common root" />
        <TextBox x:Name="CommonRootBox" Grid.Row="0" Grid.Column="1" Margin="6,2" />
        <Button Grid.Row="0" Grid.Column="2" Margin="6,2" Content="Browse…" Click="BrowseCommon_Click" />
        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Import UiLayer folder" />
        <TextBox x:Name="SourceRootBox" Grid.Row="1" Grid.Column="1" Margin="6,2" />
        <Button Grid.Row="1" Grid.Column="2" Margin="6,2" Content="Browse…" Click="BrowseSource_Click" />
      </Grid>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
        <Button Content="Load Canonical" Padding="14,5" Click="Load_Click" />
        <Button Content="Compare Import" Padding="14,5" Margin="8,0,0,0" Click="Compare_Click" />
        <Button x:Name="SaveButton" Content="Validate &amp; Save Selected Actions" Padding="14,5" Margin="8,0,0,0" IsEnabled="False" Click="Save_Click" />
        <Button x:Name="AuthorSaveButton" Content="Save Authored Bindings &amp; Layers" Padding="14,5" Margin="8,0,0,0" IsEnabled="False" Click="SaveAuthored_Click" />
        <TextBlock x:Name="SummaryText" Margin="16,5,0,0" FontWeight="SemiBold" />
      </StackPanel>
      <TextBlock x:Name="StatusText" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,8" />
    </StackPanel>

    <TabControl>
      <TabItem Header="Assignment workspace">
        <Grid Margin="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="170"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBox x:Name="CommandSearchBox" Grid.Row="0" Margin="0,0,0,6" TextChanged="CommandSearch_Changed" ToolTip="Search UI Layer command name, category, ID, or command identity"/>
          <DataGrid x:Name="UiCommandsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/><DataGridTextColumn Header="Function" Binding="{Binding Label}" Width="*"/><DataGridTextColumn Header="Function ID" Binding="{Binding Id}" Width="180"/><DataGridTextColumn Header="Command identity" Binding="{Binding Command}" Width="2*"/></DataGrid.Columns>
          </DataGrid>
          <WrapPanel Grid.Row="2" Margin="0,7">
            <TextBlock Text="Action" VerticalAlignment="Center"/><ComboBox x:Name="EditActionBox" Width="95" Margin="5,0" SelectedIndex="0"><ComboBoxItem Content="upsert"/><ComboBoxItem Content="move"/><ComboBoxItem Content="clear"/><ComboBoxItem Content="restore"/><ComboBoxItem Content="relabel"/></ComboBox>
            <TextBlock Text="Device" VerticalAlignment="Center"/><ComboBox x:Name="EditDeviceBox" Width="260" Margin="5,0" DisplayMemberPath="DeviceId" SelectionChanged="EditDevice_Changed"/>
            <TextBlock Text="Category" VerticalAlignment="Center"/><ComboBox x:Name="EditCategoryBox" Width="100" Margin="5,0" SelectedIndex="0"><ComboBoxItem Content="joystick"/><ComboBoxItem Content="keyboard"/><ComboBoxItem Content="mouse"/></ComboBox>
            <TextBlock Text="Profile" VerticalAlignment="Center"/><TextBox x:Name="EditProfileBox" Width="200" Margin="5,0" ToolTip="Native DCS profile filename; existing selection fills this automatically"/>
          </WrapPanel>
          <WrapPanel Grid.Row="3" Margin="0,0,0,7">
            <TextBlock Text="Shared control" VerticalAlignment="Center"/><ComboBox x:Name="SharedControlBox" Width="290" Margin="5,0"/>
            <TextBlock Text="Layers" VerticalAlignment="Center"/><ListBox x:Name="LayerBox" Width="230" Height="62" Margin="5,0" SelectionMode="Multiple" DisplayMemberPath="Name" ToolTip="Select zero, one, or multiple modifiers for the exact chord"/>
            <TextBlock Text="Label/name" VerticalAlignment="Center"/><TextBox x:Name="EditLabelBox" Width="180" Margin="5,0"/>
            <Button Content="Stage edit" Padding="10,3" Click="StageEdit_Click"/><Button Content="Unstage selected" Padding="10,3" Margin="6,0,0,0" Click="UnstageEdit_Click"/>
          </WrapPanel>
          <DataGrid x:Name="StagedEditsGrid" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns><DataGridTextColumn Header="Pending destination: DCS-Common authoritative UI Layer" Binding="{Binding Summary}" Width="*"/></DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="Profiles">
        <DataGrid x:Name="ProfilesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Catalog scope" Binding="{Binding CatalogState}" Width="170"/>
            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90"/>
            <DataGridTextColumn Header="Profile" Binding="{Binding Name}" Width="2*"/>
            <DataGridTextColumn Header="Keys / buttons" Binding="{Binding KeyCount}" Width="110"/>
            <DataGridTextColumn Header="Axes" Binding="{Binding AxisCount}" Width="70"/>
            <DataGridTextColumn Header="Effective" Binding="{Binding EffectiveCount}" Width="80"/>
            <DataGridTextColumn Header="Fingerprint" Binding="{Binding Fingerprint}" Width="2*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Bindings">
        <DataGrid x:Name="BindingsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="BindingSelection_Changed">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Catalog scope" Binding="{Binding CatalogState}" Width="170"/>
            <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="1.5*"/>
            <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="90"/>
            <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="1.4*"/>
            <DataGridTextColumn Header="DCS name" Binding="{Binding Name}" Width="1.5*"/>
            <DataGridTextColumn Header="Input" Binding="{Binding Key}" Width="110"/>
            <DataGridTextColumn Header="Shared control" Binding="{Binding HardwareLabel}" Width="140"/>
            <DataGridTextColumn Header="Modifier chord" Binding="{Binding Chord}" Width="1.5*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Modifiers">
        <DockPanel><TextBlock DockPanel.Dock="Top" Margin="6" TextWrapping="Wrap" Text="Layer Manager: add, edit, rename, or remove deliberate authoritative modifiers here. Save Authored Bindings &amp; Layers validates every dependent profile before committing."/>
        <DataGrid x:Name="ModifiersGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.5*"/>
            <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="2*"/>
            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="120"/>
            <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="100"/>
          </DataGrid.Columns>
        </DataGrid></DockPanel>
      </TabItem>
      <TabItem Header="Device possibilities">
        <DataGrid x:Name="PossibilitiesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Configured device ID" Binding="{Binding DeviceId}" Width="1.5*"/>
            <DataGridTextColumn Header="Canonical hardware" Binding="{Binding CanonicalDeviceId}" Width="1.3*"/>
            <DataGridTextColumn Header="Device" Binding="{Binding Label}" Width="1.5*"/>
            <DataGridTextColumn Header="Modifier possibility" Binding="{Binding Modifier}" Width="1.4*"/>
            <DataGridTextColumn Header="Overlay" Binding="{Binding OverlayStatus}" Width="90"/>
            <DataGridTextColumn Header="Instances" Binding="{Binding InstanceDisplay}" Width="100"/>
            <DataGridTextColumn Header="Catalog scope" Binding="{Binding CatalogState}" Width="140"/>
            <DataGridTextColumn Header="Module applicability" Binding="{Binding Applicability}" Width="2*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Reconciliation">
        <DataGrid x:Name="ChangesGrid" AutoGenerateColumns="False" CanUserAddRows="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="2*" IsReadOnly="True"/>
            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="130" IsReadOnly="True"/>
            <DataGridComboBoxColumn Header="Action" SelectedItemBinding="{Binding Action, UpdateSourceTrigger=PropertyChanged}" Width="130">
              <DataGridComboBoxColumn.ElementStyle><Style TargetType="ComboBox"><Setter Property="ItemsSource" Value="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType=Window}}"/></Style></DataGridComboBoxColumn.ElementStyle>
              <DataGridComboBoxColumn.EditingElementStyle><Style TargetType="ComboBox"><Setter Property="ItemsSource" Value="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType=Window}}"/></Style></DataGridComboBoxColumn.EditingElementStyle>
            </DataGridComboBoxColumn>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Validation errors">
        <ListBox x:Name="ErrorsList" Foreground="#9C0006" />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
