<Window x:Class="DcsConsumerScaffold.UiLayerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Definitive UI Layer Editor" Height="820" Width="1350" MinHeight="600" MinWidth="900">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="Definitive UI Layer Editor" />
      <TextBlock Margin="0,3,0,8" Foreground="#555" TextWrapping="Wrap"
                 Text="Maintain the complete DCS-Common UI Layer independently of connected devices. Compare an imported Saved Games UiLayer folder, choose explicit actions, then validate and save atomically." />
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="DCS-Common root" />
        <TextBox x:Name="CommonRootBox" Grid.Row="0" Grid.Column="1" Margin="6,2" />
        <Button Grid.Row="0" Grid.Column="2" Margin="6,2" Content="Browse…" Click="BrowseCommon_Click" />
        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Import UiLayer folder" />
        <TextBox x:Name="SourceRootBox" Grid.Row="1" Grid.Column="1" Margin="6,2" />
        <Button Grid.Row="1" Grid.Column="2" Margin="6,2" Content="Browse…" Click="BrowseSource_Click" />
      </Grid>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
        <Button Content="Load Canonical" Padding="14,5" Click="Load_Click" />
        <Button Content="Compare Import" Padding="14,5" Margin="8,0,0,0" Click="Compare_Click" />
        <Button x:Name="SaveButton" Content="Validate &amp; Save Selected Actions" Padding="14,5" Margin="8,0,0,0" IsEnabled="False" Click="Save_Click" />
        <TextBlock x:Name="SummaryText" Margin="16,5,0,0" FontWeight="SemiBold" />
      </StackPanel>
      <TextBlock x:Name="StatusText" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,8" />
    </StackPanel>

    <TabControl>
      <TabItem Header="Profiles">
        <DataGrid x:Name="ProfilesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90"/>
            <DataGridTextColumn Header="Profile" Binding="{Binding Name}" Width="2*"/>
            <DataGridTextColumn Header="Keys / buttons" Binding="{Binding KeyCount}" Width="110"/>
            <DataGridTextColumn Header="Axes" Binding="{Binding AxisCount}" Width="70"/>
            <DataGridTextColumn Header="Effective" Binding="{Binding EffectiveCount}" Width="80"/>
            <DataGridTextColumn Header="Fingerprint" Binding="{Binding Fingerprint}" Width="2*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Bindings">
        <DataGrid x:Name="BindingsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="1.5*"/>
            <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="90"/>
            <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="1.4*"/>
            <DataGridTextColumn Header="DCS name" Binding="{Binding Name}" Width="1.5*"/>
            <DataGridTextColumn Header="Input" Binding="{Binding Key}" Width="110"/>
            <DataGridTextColumn Header="Modifier chord" Binding="{Binding Chord}" Width="1.5*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Modifiers">
        <DataGrid x:Name="ModifiersGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.5*"/>
            <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="2*"/>
            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="120"/>
            <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="100"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Reconciliation">
        <DataGrid x:Name="ChangesGrid" AutoGenerateColumns="False" CanUserAddRows="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="2*" IsReadOnly="True"/>
            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="130" IsReadOnly="True"/>
            <DataGridComboBoxColumn Header="Action" SelectedItemBinding="{Binding Action, UpdateSourceTrigger=PropertyChanged}" Width="130">
              <DataGridComboBoxColumn.ElementStyle><Style TargetType="ComboBox"><Setter Property="ItemsSource" Value="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType=Window}}"/></Style></DataGridComboBoxColumn.ElementStyle>
              <DataGridComboBoxColumn.EditingElementStyle><Style TargetType="ComboBox"><Setter Property="ItemsSource" Value="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType=Window}}"/></Style></DataGridComboBoxColumn.EditingElementStyle>
            </DataGridComboBoxColumn>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Validation errors">
        <ListBox x:Name="ErrorsList" Foreground="#9C0006" />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
