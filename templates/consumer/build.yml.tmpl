name: Build OVGME package
on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

# contents: write is required when commit-kneeboard is true so the
# reusable workflow can push regenerated SVG/PNG back to main.
permissions:
  contents: write

jobs:
  build:
    uses: ScottyMac52/DCS-Common/.github/workflows/build.yml@main
    with:
      package-version: 0.0.0-ci.${{ github.run_number }}
      install-lua-parser: true
      run-lua-parse: true
      run-release-validation: true
      package-script: scripts/Build-OvGME.ps1
      test-package-script: scripts/Test-Package.ps1
      build-release-script: scripts/Build-Release.ps1
      test-release-script: scripts/Test-Package.ps1
      # Keep repo kneeboard assets in lockstep with the OvGME package.
      # Skipped automatically on pull_request; runs on main push / workflow_dispatch.
      commit-kneeboard: true
      kneeboard-paths: kneeboard/source kneeboard/{{KNEEBOARD_ID}}
      artifact-name: {{ARTIFACT_NAME}}-Release
      artifact-path: |
        dist/*.zip
        dist/SHA256SUMS.txt
